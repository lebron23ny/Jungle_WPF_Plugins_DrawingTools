<tsd:PluginWindowBase x:Class="Jungle_WPF_Plugins_DrawingTools.DimensionToAxis.MainWindow_DimToAxis"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Jungle_WPF_Plugins_DrawingTools.DimensionToAxis"
        xmlns:tsd="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
        xmlns:UIControls="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"        
        mc:Ignorable="d"   ResizeMode="NoResize"                  
        Title="{tsd:Loc albl_NamePlugin_DimToAxis}"                                             
                      Height="350" Width="600">
    <tsd:PluginWindowBase.DataContext>
        <local:MainWindowViewModelDTA/>
    </tsd:PluginWindowBase.DataContext>
    <tsd:PluginWindowBase.Resources>
        <Style x:Key="style_tb">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ItemsControl.VerticalAlignment" Value="Stretch"/>
            <Setter Property="ItemsControl.HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ItemsControl.VerticalContentAlignment" Value="Center"/>
        </Style>
    </tsd:PluginWindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        
            <UIControls:WpfSaveLoad Grid.Row="1"
                x:Name="wpf_save_load" 
                                 />
        
        
            <UIControls:WpfOkApplyModifyGetOnOffCancel 
                Grid.Row="3"
                ApplyClicked="WpfOkApplyModifyGetOnOffCancel_ApplyClicked" 
                CancelClicked="WpfOkApplyModifyGetOnOffCancel_CancelClicked" 
                GetClicked="WpfOkApplyModifyGetOnOffCancel_GetClicked" 
                ModifyClicked="WpfOkApplyModifyGetOnOffCancel_ModifyClicked" 
                OkClicked="WpfOkApplyModifyGetOnOffCancel_OkClicked" 
                OnOffClicked="WpfOkApplyModifyGetOnOffCancel_OnOffClicked"
                />
        
        
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <UIControls:WpfFilterCheckBox Grid.Row="0" Grid.Column="0"
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"
                                              AttributeName="IndexType"
                                              />
                <TextBlock Grid.Row="0" Grid.Column="1" 
                           Text="{tsd:Loc albl_Mode_DimToAxis}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="2"
                          SelectedIndex="{Binding IndexType, Mode=TwoWay}">
                    <ComboBoxItem IsSelected="True" Content="{tsd:Loc albl_Mode1_DimToAxis}"
                                  VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                    <ComboBoxItem Content="{tsd:Loc albl_Mode2_DimToAxis}"/>
                    <ComboBoxItem Content="{tsd:Loc albl_Mode3_DimToAxis}"/>
                </ComboBox>


                <UIControls:WpfFilterCheckBox Grid.Row="1" Grid.Column="0"
                                              VerticalAlignment="Center" 
                                                HorizontalAlignment="Center"
                                                AttributeName="DistanceDim"/>
                <TextBlock Grid.Row="1" Grid.Column="1" 
                           Text="{tsd:Loc albl_Size_DimToAxis}" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="2"
                         Text="{Binding DistanceDim}"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>

                <UIControls:WpfFilterCheckBox Grid.Row="2" Grid.Column="0"
                                              AttributeName="NameDimAttr"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{tsd:Loc albl_AttrSize_DimToAxis}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBox Grid.Row="2" Grid.Column="2"
                         Text="{Binding NameDimAttr}"
                         Style="{StaticResource style_tb}"/>

                <UIControls:WpfFilterCheckBox Grid.Row="3" Grid.Column="0"
                                              AttributeName="NameTextAttr"
                                              HorizontalAlignment="Center"
                                              VerticalContentAlignment="Center"/>
                
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{tsd:Loc albl_AttrText_DimToAxis}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           />

                <TextBox Grid.Row="3" Grid.Column="2"
                         Text="{Binding NameTextAttr}"
                         VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

            <UIControls:WpfFilterCheckBox Grid.Row="4" Grid.Column="0"
                              AttributeName="LengthAxis"
                              HorizontalAlignment="Center"
                              VerticalContentAlignment="Center"/>


            <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="{tsd:Loc albl_LengthAxis_DimToAxis}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       />

            <TextBox Grid.Row="4" Grid.Column="2"
                         Text="{Binding LengthAxis}"
                         VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>







        </Grid>
            
        
    </Grid>
</tsd:PluginWindowBase>
